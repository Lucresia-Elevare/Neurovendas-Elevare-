# ========================================
# ELEVARE/LUCRESIA - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill with your actual values

# ========================================
# DATABASE
# ========================================
DATABASE_URL=mysql://user:password@localhost:3306/elevare

# ========================================
# AUTHENTICATION & SECURITY
# ========================================
# Secret key for JWT token generation (use a strong random string)
JWT_SECRET=your-secret-key-minimum-32-characters-long

# OAuth server URL for authentication
OAUTH_SERVER_URL=https://oauth.example.com

# Owner OpenID (admin user identifier)
OWNER_OPEN_ID=admin-user-open-id

# ========================================
# CANVA INTEGRATION
# ========================================
# Canva API credentials for design integration
CANVA_CLIENT_ID=your-canva-client-id
CANVA_CLIENT_SECRET=your-canva-client-secret

# ========================================
# AWS S3 STORAGE
# ========================================
# AWS credentials for image storage
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=elevare-uploads

# ========================================
# APPLICATION CONFIGURATION
# ========================================
# Unique application identifier
VITE_APP_ID=elevare

# Application URL (adjust for production)
VITE_APP_URL=http://localhost:3000

# Environment mode
NODE_ENV=development

# ========================================
# AI / LLM INTEGRATION
# ========================================
# OpenAI API key for LucresIA features
OPENAI_API_KEY=sk-your-openai-api-key-here

# Built-in Forge API (optional)
BUILT_IN_FORGE_API_URL=https://forge-api.example.com
BUILT_IN_FORGE_API_KEY=your-forge-api-key

# ========================================
# ANALYTICS (OPTIONAL)
# ========================================
# Umami analytics configuration
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
VITE_ANALYTICS_WEBSITE_ID=your-website-id

# ========================================
# INSTAGRAM INTEGRATION (FUTURE)
# ========================================
# Instagram API credentials for post publishing
# INSTAGRAM_CLIENT_ID=your-instagram-client-id
# INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret
# INSTAGRAM_REDIRECT_URI=https://your-app.com/auth/instagram/callback
